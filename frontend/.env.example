# Raj Studio frontend — configuration
# Copy to .env.local and adjust for your setup. Do NOT commit .env or .env.local.

# URL of the ACE-Step FastAPI backend (used by both the app and the dev proxy).
# Common values:
#   http://127.0.0.1:8001   (default, matches start_api_server_macos.sh)
#   http://localhost:8001
VITE_API_URL=http://127.0.0.1:8001

# Optional bearer/API key. Only set this if the backend was launched with
# ACESTEP_API_KEY. Never hardcode secrets — this is read from the local env.
VITE_API_KEY=
